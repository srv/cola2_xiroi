<?xml version="1.0"?>
<robot name="Sparus2">

<!-- Links -->

  <link name="sparus2">
    <visual>
      <origin xyz="0.0 0 0" rpy="-1.57 0 0"/>
      <geometry>
        <mesh filename="package://cola2_s2/data/model/sparus2.3ds" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <link name="seaking_profiler">
    <!--visual>
      <origin rpy="0.0 0.0 0.0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual-->
  </link>

  <joint name="robot2profiler" type="continuous">
    <parent link="sparus2"/>
    <child  link="seaking_profiler"/>
    <axis xyz="0 0 1"/>
    <origin rpy="0 0 3.141592653589793" xyz="0.7 0.0 -0.14"/>
  </joint>

</robot>
