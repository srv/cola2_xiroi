<launch>
  <arg name="type" default="narrow" /> 
  <arg name="base_topic" default="stereo_$(arg type)" />
  <arg name="camera" default="bb2_$(arg type)" />   
  <arg name="calibration" default="boxed_water" />
  <arg name="camera_params" default="$(find cola2_xiroi)/config/cameras/$(arg camera)/$(arg base_topic)_params.yaml" />
  <arg name="processing" default="true"/>
  <arg name="decimate" default="false"/>
  <arg name="decimation" default="2"/>
  <arg name="throttle" default="false"/>

  <!-- Driver -->
  <node pkg="camera1394stereo" type="camera1394stereo_node" name="$(arg base_topic)_node" output="screen" >
      <rosparam file="$(arg camera_params)" />
      <param name="frame_id" value="$(arg base_topic)/left_optical" />
      <param name="camera_info_url_left" value="file://$(find cola2_xiroi)/config/cameras/$(arg camera)/calibration_$(arg calibration)_left.yaml" />
      <param name="camera_info_url_right" value="file://$(find cola2_xiroi)/config/cameras/$(arg camera)/calibration_$(arg calibration)_right.yaml" />
      <remap from="stereo_camera" to="$(arg base_topic)" />
  </node>
  
  <!-- Decimate -->
  <include if="$(arg decimate)" file="$(find cola2_xiroi)/launch/modules/stereo_crop_decimate.launch" >
      <arg name="stereo" value="$(arg base_topic)" />
      <arg name="decimation" value="$(arg decimation)" />
  </include>


  <!-- Stereo Processing -->
  <group  if="$(arg processing)">
    <node unless="$(arg decimate)" ns="$(arg base_topic)"  name="stereo_image_proc" pkg="stereo_image_proc" type="stereo_image_proc">
      <rosparam file="$(find cola2_xiroi)/config/cameras/$(arg camera)/disparity_params.yaml"/>
    </node>
    <node if="$(arg decimate)" ns="$(arg base_topic)/scaled_x$(arg decimation)" name="stereo_image_proc" pkg="stereo_image_proc" type="stereo_image_proc">
      <rosparam file="$(find cola2_xiroi)/config/cameras/$(arg camera)/disparity_params_x$(arg decimation).yaml"/>
    </node>
  </group>

  <!-- Throttle -->
  <node if="$(arg throttle)" name="nav_sts_throttle" pkg="topic_tools" type="throttle" args="messages $(arg base_topic)/image_color_raw 1.0">
  </node>
</launch>

