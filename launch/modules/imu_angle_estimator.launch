<launch>
    <arg name="robot_name" default="xiroi"/>

    <group ns="$(arg robot_name)">
        <rosparam command="load" file="$(find cola2_xiroi)/config/imu_angle_estimator.yaml"/>
        <node name="imu_angle_estimator" pkg="cola2_xiroi" type="imu_angle_estimator.py" output="screen">
            <remap from="mag" to="sensors/mag_raw_driver" />
            <remap from="imu" to="sensors/imu_raw_driver" />
        </node>
    </group>
</launch>