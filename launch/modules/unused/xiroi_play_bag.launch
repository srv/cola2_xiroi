<launch>
    <arg name="bag_file" default="/home/antoni/Bagfiles/tests_imu_tripode/gps_traj_1.bag"/>
    <!-- <arg name="bag_file" default="/home/antoni/Bagfiles/EKF_test_imu/antena/2019-03-15-11-00-38.bag"/> -->
    <arg name="rosbag_args" default=""/>
    <arg name="enable_rviz" default="false"/>

    <!-- ROSBag -->
    <param name="use_sim_time" value="true"/>
    <node pkg="rosbag" type="play" name="rosbag" args="--clock $(arg rosbag_args) $(arg bag_file)">
     <!-- <remap from="/xiroi/sensors/gps_raw" to="/sensors/gps_raw"/> -->
    </node>

    <!-- Load robot description -->
    <!-- <group ns="xiroi">
        <include file="$(find xiroi_description)/launch/xiroi_description.launch">
            <arg name="robot_name" value="xiroi"/>
        </include>
    </group> -->

     <!-- MADGWICK     -->
    <!-- <rosparam command="load" file="$(find cola2_xiroi)/config/imu_madgwick.yaml"/>
    <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_madgwick" output="screen">
        <remap from="imu/data_raw" to="/xiroi/sensors/imu_cal_driver"/>    
        <remap from="imu/mag" to="/xiroi/sensors/mag_raw_driver"/>         
        <remap from="imu/data" to="/sensors/imu_raw"/>      
    </node>
    <rosparam command="load" file="$(find cola2_xiroi)/config/sensor_aggregator.yaml"/>
    <node name="sensor_aggregator" pkg="cola2_xiroi" type="sensor_aggregator" output="screen" respawn="true"/> -->


    <!-- Upside down TF -->
    <!-- <node name="world2ned" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 3.14159 world world_ned 100"/> -->

    <!-- RViz -->
    <!-- <node if="$(arg enable_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find cola2_xiroi)/scene/xiroi.rviz"/> -->
</launch>
