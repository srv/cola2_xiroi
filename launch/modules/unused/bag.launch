<!-- THIS LAUNCH FILE IS INTENDED TO BE USED FROM THE NODE cola2_lib bag_node.py -->
<launch>
    <arg name="robot_name"/>
    <group ns="$(arg robot_name)">
        <node name="record_auv_bag" output="screen" pkg="rosbag" type="record" args="
            -a -x '/$(arg robot_name)/camera/(.*)'
            --split --size 2048 -o $(env HOME)/bags/$(arg robot_name)" />

        <node name="record_auv_image" output="screen" pkg="rosbag" type="record" args="
            /$(arg robot_name)/navigator/odometry
            /$(arg robot_name)/navigator/navigation
            /$(arg robot_name)/stereo_wide/disparity
            /$(arg robot_name)/stereo_wide/left/camera_info
            /$(arg robot_name)/stereo_wide/left/image_color
            /$(arg robot_name)/stereo_wide/left/image_color/theora
            /$(arg robot_name)/stereo_wide/left/image_color/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/left/image_color/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/left/image_mono
            /$(arg robot_name)/stereo_wide/left/image_mono/theora
            /$(arg robot_name)/stereo_wide/left/image_mono/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/left/image_mono/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/left/image_raw
            /$(arg robot_name)/stereo_wide/left/image_raw/theora
            /$(arg robot_name)/stereo_wide/left/image_raw/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/left/image_raw/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/left/image_rect
            /$(arg robot_name)/stereo_wide/left/image_rect/theora
            /$(arg robot_name)/stereo_wide/left/image_rect/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/left/image_rect/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/left/image_rect_color
            /$(arg robot_name)/stereo_wide/left/image_rect_color/theora
            /$(arg robot_name)/stereo_wide/left/image_rect_color/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/left/image_rect_color/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/points2
            /$(arg robot_name)/stereo_wide/right/camera_info
            /$(arg robot_name)/stereo_wide/right/image_color
            /$(arg robot_name)/stereo_wide/right/image_color/theora
            /$(arg robot_name)/stereo_wide/right/image_color/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/right/image_color/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/right/image_mono
            /$(arg robot_name)/stereo_wide/right/image_mono/theora
            /$(arg robot_name)/stereo_wide/right/image_mono/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/right/image_mono/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/right/image_raw
            /$(arg robot_name)/stereo_wide/right/image_raw/theora
            /$(arg robot_name)/stereo_wide/right/image_raw/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/right/image_raw/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/right/image_rect
            /$(arg robot_name)/stereo_wide/right/image_rect/theora
            /$(arg robot_name)/stereo_wide/right/image_rect/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/right/image_rect/theora/parameter_updates
            /$(arg robot_name)/stereo_wide/right/image_rect_color
            /$(arg robot_name)/stereo_wide/right/image_rect_color/theora
            /$(arg robot_name)/stereo_wide/right/image_rect_color/theora/parameter_descriptions
            /$(arg robot_name)/stereo_wide/right/image_rect_color/theora/parameter_updates
            /$(arg robot_name)/stereo_wide_node/parameter_descriptions
            /$(arg robot_name)/stereo_wide_node/parameter_updates
            --split --size 2048 -o $(env HOME)/bags/$(arg robot_name)_image" />
    </group>
</launch>
