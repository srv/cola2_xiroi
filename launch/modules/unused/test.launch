<launch>
  <!-- PARAMS -->
  <arg name="imu_node" default="false"/>
  <arg name="enableGPS" default="false" />


  <!-- CONFIGS -->
  <arg name="razor_config_file" default="$(find cola2_xiroi)/config/imu_razor.yaml"/>
  <rosparam command="load" file="$(find cola2_xiroi)/config/gps_emlid.yaml" />

  <!-- IMU -->
  <group unless="$(arg imu_node)">
    <node pkg="razor_imu_9dof" type="imu_node_extend.py" name="imu_node" output="screen">
      <rosparam file="$(arg razor_config_file)" command="load"/>
      <remap from="imu_raw" to="/xiroi/sensors/imu_raw_driver"/>
      <remap from="mag_raw" to="/xiroi/sensors/mag_raw_driver"/>
      <remap from="imu_cal" to="/xiroi/sensors/imu_cal_driver"/>
      <remap from="mag_cal" to="/xiroi/sensors/mag_cal_driver"/>
    </node> 
  </group>
  <group if="$(arg imu_node)">
    <node pkg="razor_imu_9dof" type="imu_node.py" name="imu_node" output="screen">
      <rosparam file="$(arg razor_config_file)" command="load"/>
      <remap from="imu" to="/xiroi/sensors/imu_raw"/>
    </node>
  </group>

  <!-- MAG CALIBRATION -->
  <node name="mag_calibration" pkg="cola2_xiroi" type="mag_calibration.py" respawn="true">
      <remap from="mag_driver" to="/xiroi/sensors/mag_raw_driver"/>
      <remap from="mag" to="/xiroi/sensors/mag"/>  
      <remap from="imu_driver" to="/xiroi/sensors/imu_raw_driver"/>
      <remap from="imu" to="/xiroi/sensors/imu"/>  
    </node>

  <!-- GPS -->
  <node if="$(arg enableGPS)" name="emlid_driver" pkg="emlid_reach_tcp" type="emlid_driver.py" output="screen">
    <remap from="emlid_gps" to="/xiroi/sensors/gps_raw" />
    <remap from="/diagnostics" to="/xiroi/sensors/gps_diagnostics" />
  </node>
</launch>
