<launch>

    <node name="visual_depth" pkg="cola2_xiroi" type="visual_depth.py" output="screen">
        <param name = "base_link_frame_id" value = "xiroi/base_link"/>
        <param name = "sensor_frame_id" value = "xiroi/stereo_ch3/left_optical"/>
        <param name = "base_link_to_water_surface" value = "0.07" />
    </node>

</launch>