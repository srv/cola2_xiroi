<launch>
  <arg name="camera" default="narrow" /> 
  <arg name="base_topic" default="stereo_$(arg type)" />



  <!-- Driver -->
  <node pkg="visual_altimeter" type="visual_altimeter" name="visual_altimeter_$(arg camera)" respawn="false" output="screen">
    <param name="left_serial_number" value="$(arg left_serial)"/>
    <param name="right_serial_number" value="$(arg right_serial)" />
    <param name="left_camera_info_url" value="file://$(find cola2_xiroi)/config/cameras/$(arg camera)/CM3-U3-31S4C_$(arg left_serial)/calibration_$(arg calibration).yaml" />
    <param name="right_camera_info_url" value="file://$(find cola2_xiroi)/config/cameras/$(arg camera)/CM3-U3-31S4C_$(arg right_serial)/calibration_$(arg calibration).yaml"/>
  </node>


</launch>

