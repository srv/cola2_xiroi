
<launch>

      <!-- MEMSENSE IMU NODE -->
      <node pkg="memsense_imu" type="imu_node" name="imu_memsense_node" output="screen">
        <param name="polling_rate" value="150.00" type="double" />
        <param name="filter_rate"  value="10.0" type="double" />
        <param name="frame_id"     value="xiroi/imu" type="string" />
        <param name="serial_port"  value="/dev/serial/by-id/usb-Silicon_Labs_CP2101_USB_to_UART_Bridge_Controller_0001-if00-port0
" type="string"/>
        <param name="imu_type"     value="nIMU_3temp" type="string" />

        <param name="accels_range" value="19.620000000000001" type="double" />
        <param name="gyros_range"  value="2.617993877991494" type="double" />
        <param name="mags_range"   value="1.8999999999999999" type="double" />


        <param name="accel_bias_x" value="1.31392" type="double" />
        <param name="accel_bias_y" value="0.933712" type="double" />
        <param name="accel_bias_z" value="0.758749" type="double" />

        <param name="gyro_bias_x"  value="0.0192" type="double" />
        <param name="gyro_bias_y"  value="-0.0013" type="double" />
        <param name="gyro_bias_z"  value="-0.0082" type="double" />

        <param name="mag_bias_x"   value="-0.0124142" type="double" />
        <param name="mag_bias_y"   value="0.0204217" type="double" />
        <param name="mag_bias_z"   value="0.0107939" type="double" />
        <param name="mag_trans_xx" value="0.895491" type="double" />
        <param name="mag_trans_xy" value="0.0545981" type="double" />
        <param name="mag_trans_xz" value="-0.0210078" type="double" />
        <param name="mag_trans_yx" value="0.0545981," type="double" />
        <param name="mag_trans_yy" value="0.893628," type="double" />
        <param name="mag_trans_yz" value="0.0387674" type="double" />
        <param name="mag_trans_zx" value="-0.0210078" type="double" />
        <param name="mag_trans_zy" value="0.0387674" type="double" />
        <param name="mag_trans_zz" value="0.985855" type="double" />

        <param name="accels_var"   value="0.0" type="double" />
        <param name="gyros_var"    value="0.0" type="double" />
        <param name="mags_var"     value="0.0" type="double" />

                
        <remap from="imu/data" to="sensors/ "/>
        <remap from="imu/data_calibrated" to="sensors/imu_raw_calibrated"/>
        <remap from="imu/data_filtered" to="sensors/imu_raw_filtered"/>
        <remap from="imu/data_filtered_calibrated" to="sensors/imu_raw_filtered_calibrated"/>
        <remap from="imu/mag" to="sensors/imu_mag"/>
        <remap from="imu/mag_calibrated" to="sensors/imu_mag_calibrated"/>
        <remap from="imu/mag_filtered" to="sensors/imu_mag_filtered"/>
        <remap from="imu/mag_filtered_calibrated" to="sensors/imu_mag_filtered_calibrated"/>
      </node>

</launch>