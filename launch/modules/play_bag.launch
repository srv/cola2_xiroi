<launch>
    <!-- Bagfile -->
    <arg name="dataset" default="papallones2"/>
    <arg name="rate"    default="0.5"/>
    <!-- General Settings -->
    <arg name="place" default="papallones.yaml"/>
    <arg name="enableRobotArchitecture" default="true"/>
    <arg name="robot_name"              default="xiroi"/>
    
    <!-- Core -->
    <arg name="enableSafety" default="false"/>
    <!-- Payload -->
    <arg name="enableBB2narrow" default="false"/>
    <arg name="enableBB2wide"   default="false"/>
    <arg name="enableCH3"       default="false"/>
    <arg name="enableUSBL"      default="false"/>
    <!-- Interfaces -->
    <arg name="enableRviz" default="true"/>
    <arg name="enableIqua" default="false"/>

    <!-- Play bagfile -->
    <include file="$(find cola2_xiroi)/config/bag_loader/$(arg dataset).xml">
        <arg name="rate" value="$(arg rate)"/>
        <arg name="enableRobotArchitecture" value="$(arg enableRobotArchitecture)"/>
    </include>

    <!-- Load robot arquitecture -->
    <group if="$(arg enableRobotArchitecture)" ns="$(arg robot_name)">
        <!-- Load general configs-->
        <include file="$(find cola2_xiroi)/launch/modules/configs.launch">
            <arg name="place" value="$(arg place)"/>
            <arg name="robot_name" value="$(arg robot_name)"/>
        </include>

        <!-- Load core -->
        <include file="$(find cola2_xiroi)/launch/modules/core.launch">
            <arg name="place" value="$(arg place)"/>
            <arg name="robot_name" value="$(arg robot_name)"/>
            <arg name="sim" value="true"/>
            <arg name="simGPS" value="true"/>
            <arg name="enableSafety" value="$(arg enableSafety)"/>
            <arg name="openLoopTeleoperation" value="false"/>
            <arg name="enableThrusters" value="false"/>
        </include>

        <!-- Load payload -->
        <include file="$(find cola2_xiroi)/launch/modules/payload.launch">
            <arg name="robot_name" value="$(arg robot_name)"/>
            <arg name="enableBB2narrow" value="$(arg enableBB2narrow)"/>
            <arg name="enableBB2wide" value="$(arg enableBB2wide)"/>
            <arg name="enableCH3" value="$(arg enableCH3)"/>
            <arg name="enableUSBL" value="$(arg enableUSBL)"/>
        </include>

        <!-- Load interfaces -->
        <include file="$(find cola2_xiroi)/launch/modules/interfaces.launch">
            <arg name="enableIqua" value="$(arg enableIqua)"/>
        </include>
    </group>
    
    <!-- Static transform -->
    <node name="world2ned" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 3.1415 world world_ned 100"/>

    <!-- RViz -->
    <node if="$(arg enableRviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find cola2_xiroi)/scene/sim_xiroi.rviz"/>
</launch>
