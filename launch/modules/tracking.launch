<launch>
    <arg name="robot_name" default="xiroi"/>
    <!-- <group ns="$(arg robot_name)"> -->
        <rosparam command="load" file="$(find cola2_xiroi)/config/auv_follow.yaml"/>
        <node name="auv_tracking" pkg="cola2_xiroi" type="auv_tracking.py" respawn="true" output="screen"/>
    <!-- </group> -->
</launch>