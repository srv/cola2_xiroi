<launch>
<arg name="enableThrusters" default = "true"/>
<arg name="robot_name" default="xiroi"/>

<!-- Thrusters -->
<rosparam command="load" file="$(find cola2_xiroi)/config/thrusters.yaml"/>
<node if="$(arg enableThrusters)" name="thruster_driver" pkg="cola2_xiroi" type="bluerobotics_T200_arduino.py"  respawn="true" output="screen" >
    <remap from="setpoints" to="controller/thruster_setpoints"/> 
</node>
</launch>