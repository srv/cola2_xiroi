<launch>
    <!--  ################  Input arguments  ################  -->
    <arg name="robot_name" default="xiroi"/>
    <arg name="enableUSBL" default="true"/>
    <arg name="enableBB2narrow" default="false"/>
    <arg name="enableBB2wide" default="false"/>
    <arg name="enableCH3" default="false"/>


    <!-- USBL -->
    <group if="$(arg enableUSBL)">
        <rosparam command="load" file="$(find cola2_xiroi)/config/usbl/evologics_usbl.yaml"/>
        <param name="/evologics/config_srv_dir" value="$(find cola2_xiroi)/config/usbl/evologics_services.yaml"/>
        <include file="$(find cola2_xiroi)/launch/payload/evologics_usbl.launch"/>
        <node pkg="tf" type="static_transform_publisher" name="xiroi_to_usbl" args="0.5 0.0 0.7 0.0 0.0 0.0 /xiroi /usbl 100" />
    </group>

    <!-- Stereo Bumblebee Narrow-->
    <include if="$(arg enableBB2narrow)" file="$(find cola2_xiroi)/launch/modules/stereo_bb2.launch">
        <arg name="type"        value="narrow"/> 
        <arg name="processing"  value="true"/>
        <arg name="decimate"    value="false"/>
        <arg name="decimation"  value="2"/>
        <arg name="throttle"    value="false"/>
    </include>

    <!-- Stereo Bumblebee Wide-->
    <include if="$(arg enableBB2wide)" file="$(find cola2_xiroi)/launch/modules/stereo_bb2.launch">
        <arg name="type"        value="wide"/> 
        <arg name="processing"  value="true"/>
        <arg name="decimate"    value="false"/>
        <arg name="decimation"  value="2"/>
        <arg name="throttle"    value="false"/>
    </include>

    <!-- Stereo CH3 -->
    <include if="$(arg enableCH3)" file="$(find cola2_xiroi)/launch/modules/mono_ch3.launch">
    </include>

    <!-- Lights -->
     <!-- <node name="vehicle_lights" pkg="cola2_xiroi" type="lights_arduino.py" output="screen"/> -->

</launch>
