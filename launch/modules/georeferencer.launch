<launch> 

	<arg name="rate" default="1.0" />

	<rosparam command="load" file="$(find cola2_xiroi)/config/georeferencer.yaml" />

	<arg name="bagfile" default="/home/uib/bagfiles/10_23_37/images_2020-09-18-10-23-38_0.bag
								/home/uib/bagfiles/10_23_37/images_2020-09-18-10-48-56_1.bag
                               /home/uib/bagfiles/10_23_37/topics_2020-09-18-10-23-39_0.bag"/>


	<node pkg="rosbag" type="play" name="player" args="-d 1 -r $(arg rate) $(arg bagfile)" required="true" />



	<node name="Georef" pkg="cola2_xiroi" type="image_georeferencer.py" output="screen">
    	</node>


<!--     <node name="gps_img_tf" pkg="georeferencer" type="gps_img_tf.py" output="screen">
    </node> -->

</launch>
