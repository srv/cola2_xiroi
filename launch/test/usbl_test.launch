<launch>
    <!--  ################  Input arguments  ################  -->
    <arg name="environment" default="sea"/>

    <group ns="$(arg robot_name)">   
        <include file="$(find cola2_xiroi)/launch/payload/evologics_usbl.launch">
            <arg name="environment" value="$(arg environment)"/>
        </include>
    </group>
</launch>