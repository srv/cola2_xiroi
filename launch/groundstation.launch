<launch>
    <!-- PARAMS -->
    <arg name="robot_name" default="xiroi"/>
    <arg name="enableJoystick" default="true" />
    <arg name="enableRviz" default="false" />
    <arg name="openLoopTeleoperation" default="false" />
    <!-- <arg name="joystickDevice"  default="/dev/input/by-id/usb-Logitech_Wireless_Gamepad_F710_BB9796E6-joystick"/>  -->
    <arg name="joystickDevice"  default="/dev/input/by-id/usb-Logitech_Wireless_Gamepad_F710_2F85961A-joystick"/> 
    <!-- Wireless Monitoring -->    
    <arg name="enableWirelessLinkMonitoring" default="true"/>
    <arg name="host_name" default="192.168.1.230"/>
    
    
    <group ns="$(arg robot_name)">
        <!-- TELEOPERATION -->
        <!-- Keyboard -->
        <group unless="$(arg enableJoystick)">
            <node pkg="cola2_control" type="keyboard" name="keyboard"/>
            <node pkg="cola2_control" type="keyboard_to_teleoperation_node.py" name="keyboard_to_teleoperation"/>
        </group>
        <!-- Joystick -->
        <rosparam command="load" file="$(find cola2_xiroi)/config/joystick_logitech.yaml"/>
        <group if="$(arg enableJoystick)">
            <node respawn="true" pkg="joy" type="joy_node" name="joystick">
                <param name="dev" value="$(arg joystickDevice)"/>
                <param name="deadzone" value="0.05"/>
            </node>
            <node unless="$(arg openLoopTeleoperation)" pkg="cola2_control" type="logitech_fx10_to_teleoperation_node.py" name="joystick_to_teleoperation" output="screen" respawn="false"/>
        </group>
        <!-- Openloop -->
        <group if="$(arg openLoopTeleoperation)">
            <node pkg="cola2_xiroi" type="logitech_joy.py" name="open_loop_teleoperation"  output="screen" respawn="false" />
        </group>
    </group>

    <group ns="gs_xiroi">
        <!-- Load Wireless Monitoring -->
        <include file="$(find cola2_xiroi)/launch/modules/wireless_monitoring.launch">
            <arg name="host_name" value="$(arg host_name)"/>
            <arg name="enableWirelessLinkMonitoring" value="$(arg enableWirelessLinkMonitoring)"/>
        </include>

        <!-- Topic Logger gs -->
        <rosparam command="load" file="$(find cola2_xiroi)/config/topic_logger/topic_logger_gs.yaml"/>
        <node name="topic_logger" pkg="cola2_xiroi" type="topic_logger.py" respawn="true" output="screen">
        </node>

    </group>

    <!-- RViz -->
    <node if="$(arg enableRviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find cola2_xiroi)/scene/sim_xiroi.rviz"/>

    <!-- ROSBRIDGE -->
    <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"/>
    <node name="mjpeg_server" pkg="mjpeg_server" type="mjpeg_server"/>
</launch>

