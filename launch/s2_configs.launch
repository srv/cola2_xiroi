<launch>

    <!--  ################# Input arguments  #################  -->
    <arg name="isSimulation" default="true"/>
    <arg name="useAutosaveParams" default="false"/>
    <arg name="autosave_params_path" default="$(find cola2_s2)/config/saved_configurations"/>


    <!--  ##############  COLA2_CORE_COMMON  ##############  -->
    <rosparam command="load" file="$(find cola2_s2)/config/pilot.yaml"/>
	<rosparam command="load" file="$(find cola2_s2)/config/captain.yaml"/>
    <rosparam command="load" file="$(find cola2_s2)/config/safety.yaml"/>
    <rosparam command="load" file="$(find cola2_s2)/config/teleoperation.yaml"/>
    <rosparam command="load" file="$(find cola2_s2)/config/navigator.yaml"/>
    <rosparam command="load" ns="diagnostic_aggregator" file="$(find cola2_s2)/config/analyzers.yaml" />
    <param name="robot_description_sparus2" textfile="$(find cola2_s2)/data/model/sparus2.urdf"/>
    <param name="robot_name" value="sparus2"/>

    <group if="$(arg isSimulation)">
        <!--  ##############  COLA2_CORE_SIMULATON  ##############  -->
        <rosparam command="load" file="$(find cola2_s2)/config/dynamics_s2.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/sim_controller.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/sim_nav_sensors.yaml"/>
    </group>

    <group unless="$(arg isSimulation)">
        <!--  ################# COLA2_CORE_REAL  #################  -->
        <rosparam command="load" file="$(find cola2_s2)/config/check_sensors.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/controller.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/fastrax_it_500_gps.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/actuators_485.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/teledyne_explorer_dvl.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/adis_imu.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/imu_angle_estimator.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/s2_serial_ports.yaml"/>

        <!--  ################# COLA2_PAYLOAD  #################  -->
        <rosparam command="load" file="$(find cola2_s2)/config/bt878_framegrabber.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/evologics_modem.yaml" />
        <rosparam command="load" file="$(find cola2_s2)/config/imagenex_multibeam_sonar.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/imagenex_side_scan_sonar.yaml"/>
        <rosparam command="load" file="$(find cola2_s2)/config/soundmetrics_aris3000.yaml"/>
        <rosparam command="load" ns="echosounders_driver" file="$(find cola2_s2)/config/echosounders.yaml" />
        <rosparam command="load" ns="micron" file="$(find cola2_s2)/config/micron_params.yaml"/>
        <rosparam command="load" ns="profiler" file="$(find cola2_s2)/config/profiler_params.yaml"/>
    </group>
    <group if="$(arg useAutosaveParams)">
        <rosparam command="load" file="$(arg autosave_params_path)/latest_params.yaml"/>
    </group>
</launch>
