<launch>
    <!--  ##############  Input arguments  ##############  -->
    <arg name="enableSafety" default="true"/>
    <arg name="enableJoystick" default="false"/>
    <arg name="joystickDevice" default="/dev/input/js0"/>

    <!--  ##############  LOAD NODES  ##############  -->
    <!-- Robot description Sparus2 -->
    <node name="robot_state_publisher_sparus2" pkg="robot_state_publisher" type="state_publisher" >
        <remap from="robot_description" to="robot_description_sparus2"/>
    </node>

    <!-- Safety nodes -->
    <node name="up_time" pkg="cola2_safety" type="up_time.py" output="screen"/>
    <node name="safe_depth_altitude" pkg="cola2_safety" type="safe_depth_altitude.py" output="screen"/>
    <node name="set_zero_velocity" pkg="cola2_safety" type="set_zero_velocity.py" output="screen"/>
    <node name="recovery_actions" pkg="cola2_safety" type="recovery_actions.py" output="screen"/>
    <node name="virtual_cage" pkg="cola2_safety" type="virtual_cage.py" output="screen"/>
    <node pkg="diagnostic_aggregator" type="aggregator_node" name="diagnostic_aggregator" />
    <node if="$(arg enableSafety)" name="diagnostics_supervisor" pkg="cola2_safety" type="diagnostics_supervisor.py"/>

    <!-- Run dynamics -->
    <node name="dynamics" pkg="cola2_sim" type="dynamics.py"/>
    <node name="sim_nav_sensors_s2" pkg="cola2_s2" type="sim_nav_sensors_s2.py" output="screen"/>
    <node name="sim_actuators_s2" pkg="cola2_s2" type="sim_actuators_s2.py" output="screen"/>

    <!-- Run Navigation Stack -->
    <node name="navigator" pkg="cola2_s2" type="navigator_s2" respawn="false" output="screen"/>

    <!-- Run Control Stack -->
    <node name="teleoperation" pkg="cola2_control" type="teleoperation.py" output="screen"/>
    <node name="controller" pkg="cola2_s2" type="controller_sparus2" respawn="true"/>
    <node name="pilot" pkg="cola2_control" type="pilot.py" respawn="false" output="screen"/>
    <node name="captain" pkg="cola2_control" type="captain.py" respawn="false" output="screen"/>

    <!-- Run Teleoperation -->
    <group if="$(arg enableJoystick)">
        <node respawn="true" pkg="joy" type="joy_node" name="joystick">
            <param name="dev" value="$(arg joystickDevice)"/>
            <param name="deadzone" value="0.05"/>
        </node>
        <node respawn="false" pkg="cola2_s2" type="logitech_fx10_to_teleoperation_s2.py" name="fx10"/>
    </group>
    <group unless="$(arg enableJoystick)">
        <node name="keyboard" pkg="cola2_control" type="keyboard" output="screen">
            <remap from="/keyboard" to="/joy"/>
        </node>
        <node name="keyboard_to_teleoperation" pkg="cola2_control" type="keyboard_to_teleoperation.py" />
    </group>
</launch>
