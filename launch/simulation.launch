<launch>
    <!-- Params -->
    <arg name="place" default="uib_outdoors.yaml"/>
    <arg name="robot_name" default="xiroi"/>
    <arg name="joystickDevice" default="/dev/input/js0"/>

    <!-- Flags -->
    <arg name="enableSafety" default="false"/>
    <arg name="enableJoystick" default="false"/>
    <arg name="openLoopTeleoperation" default="false"/>

    <arg name="enableIqua" default="false"/>
    <arg name="enableRviz" default="true"/>


    <!-- ROBOT -->
    <include file="$(find cola2_xiroi)/launch/robot.launch">
        <arg name="place" value="$(arg place)"/>
        <arg name="robot_name" value="$(arg robot_name)"/>
        <arg name="enableSafety" value="$(arg enableSafety)"/>
        <arg name="openLoopTeleoperation" value="$(arg openLoopTeleoperation)"/>
        <arg name="enableIqua" value="$(arg enableIqua)"/>
        <arg name="sim" value="true"/>
        <arg name="enableThrusters" value="false"/>
        <arg name="enableBumblebee" value="false"/>
        <arg name="enableUSBL" value="false"/>
        <arg name="enableCH3" value="false"/>
    </include>

    <!-- GROUNDSTATION -->
    <include file="$(find cola2_xiroi)/launch/groundstation.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
        <arg name="enableJoystick" value="$(arg enableJoystick)" />
        <arg name="enableRviz" value="$(arg enableRviz)" />
        <arg name="openLoopTeleoperation" value="$(arg openLoopTeleoperation)" />
        <arg name="joystickDevice" value="$(arg joystickDevice)"/>
    </include>

    <!-- SIMULATE SENSORS and ACTUATORS -->
    <group ns="$(arg robot_name)">
        <rosparam command="load" file="$(find cola2_xiroi)/config/sim_sensors.yaml"/>
        <!-- IMU/GPS -->
        <node name="sim_nav_sensors" pkg="cola2_xiroi" type="sim_nav_sensors.py" output="screen"/>
        <!-- Dynamics -->
        <rosparam command="load" ns="dynamics" file="$(find cola2_xiroi)/config/dynamics.yaml"/>
        <node name="dynamics" pkg="cola2_sim" type="dynamics.py" output="screen">
            <remap from="/$(arg robot_name)/controller/thruster_setpoints" to="/$(arg robot_name)/controller/thruster_rpm"/>
        </node>
        <!-- Internal -->
        <node name="sim_internal_sensors" pkg="cola2_sim" type="sim_internal_sensors.py" output="screen"/>
        <!-- Thrusters -->
        <node name="sim_actuators" pkg="cola2_xiroi" type="sim_actuators.py" output="screen">
            <remap from="/cola2_control/thrusters_data" to="/$(arg robot_name)/controller/thruster_setpoints"/>
            <remap from="/cola2_control/sim_thrusters_data" to="/$(arg robot_name)/controller/thruster_rpm"/>
        </node>
    </group>

</launch>
