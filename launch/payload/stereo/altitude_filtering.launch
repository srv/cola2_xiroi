<launch>

    
  <arg name="launch_in_nuc" default="false"/>
  <arg name="stereo" />


  <group if="$(arg launch_in_nuc)">
    <node pkg="nodelet" type="nodelet" name="pcl_manager" args="manager" output="screen" machine="turbot-nuc"/>
    <node pkg="nodelet" type="nodelet" name="voxel_grid" args="load pcl/VoxelGrid pcl_manager" output="screen" machine="turbot-nuc">
        <remap from="~input" to="$(arg stereo)/points2" />
        <remap from="~output" to="$(arg stereo)/points2_filtered" />
        <rosparam>
        filter_field_name: z
        filter_limit_min: 0.5
        filter_limit_max: 10
        filter_limit_negative: False
        leaf_size: 0.1
      </rosparam>
    </node>
  </group>

  <group unless="$(arg launch_in_nuc)">
    <node pkg="nodelet" type="nodelet" name="pcl_manager" args="manager" output="screen" />
    <node pkg="nodelet" type="nodelet" name="voxel_grid" args="load pcl/VoxelGrid pcl_manager" output="screen">
        <remap from="~input" to="$(arg stereo)/points2" />
        <remap from="~output" to="$(arg stereo)/points2_filtered" />
        <rosparam>
        filter_field_name: z
        filter_limit_min: 0.5
        filter_limit_max: 10
        filter_limit_negative: False
        leaf_size: 0.1
      </rosparam>
    </node>

  </group>

</launch>