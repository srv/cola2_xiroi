<launch>
  <arg name="camera" default="ch3" />   
  <arg name="base_topic" default="stereo_$(arg camera)" />
  <arg name="calibration" default="water"/>
  <arg name="throttle" default="false"/>
  <arg name="ID" default="16401228"/>

  <!-- Driver -->
  <group ns="$(arg base_topic)/left">
    <include file="$(find pointgrey_camera_driver)/launch/camera.launch" >
        <arg name="camera_serial" value="$(arg ID)" />
        <arg name="camera_info_url" value="file://$(find cola2_xiroi)/config/cameras/$(arg camera)/CM3-U3-31S4C_$(arg ID)/calibration_$(arg calibration).yaml" />
    </include>
    <rosparam command="load" file="$(find cola2_xiroi)/config/cameras/$(arg camera)/CM3-U3-31S4C_$(arg ID)/params.yaml"/>
  </group>

  <!-- Throttle -->
  <node if="$(arg throttle)" name="nav_sts_throttle" pkg="topic_tools" type="throttle" args="messages $(arg base_topic)/image_color_raw 1.0">
  </node>
</launch>

