<launch>

  <!-- ROBOT -->
  <arg name="robot_name"               default="xiroi"/>

  <!-- CAMERA -->
  <arg name="camera"                   default="ch3" />
  <arg name="stereo"                   default="stereo_$(arg camera)"/>
  <arg name="base_topic"               default="stereo_$(arg camera)" />

  <!-- PROCESSING -->
  <arg name="processing"               default="true"/>
  <arg name="decimation"               default="4"/>


  <!-- DRIVER -->
  <arg name="calibration"              default="water" />
  <arg name="right_ID"                 default="16401229" />

  <group ns="$(arg robot_name)">

    <!-- Driver -->
    <group ns="$(arg base_topic)/right">
        <rosparam command="load" file="$(find cola2_xiroi)/config/cameras/$(arg camera)/CM3-U3-31S4C_$(arg right_ID)/params.yaml" ns="spinnaker_camera_nodelet"/>
        <include file="$(find spinnaker_camera_driver)/launch/camera.launch" >
            <arg name="camera_serial" value="$(arg right_ID)" />
            <arg name="camera_info_url" value="file://$(find cola2_xiroi)/config/cameras/$(arg camera)/CM3-U3-31S4C_$(arg right_ID)/calibration_$(arg calibration).yaml" />
            <arg name="camera_flip" value="false" />
            <arg name="frame_id" value="$(arg robot_name)/stereo_ch3/right_optical" />
        </include>
    </group>

    <include if="$(arg processing)" file="$(find cola2_xiroi)/launch/payload/stereo/stereo_crop_decimate.launch" >
      <arg name="stereo" value="$(arg stereo)" />
      <arg name="decimation" value="$(arg decimation)" />
    </include>


  </group>
</launch>
