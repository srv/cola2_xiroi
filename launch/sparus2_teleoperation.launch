<launch>
    <!-- JOYSTICK -->
    <group ns="sparus2">
        <node respawn="true" pkg="joy" type="joy_node" name="joystick">
            <param name="dev" value="/dev/input/js0"/>
            <param name="deadzone" value="0.05"/>
        </node>
        <rosparam command="load" file="$(find cola2_sparus2)/config/logitech_fx10_to_teleoperation.yaml"/>
        <node name="fx10_to_teleoperation" pkg="cola2_control" type="logitech_fx10_to_teleoperation_node.py" respawn="false"/>
    </group>
</launch>
