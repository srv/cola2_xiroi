
<launch>
    <!-- PARAMS -->
    <arg name="robot_name" default="xiroi"/>
    <arg name="enableJoystick" default="true" />
    <arg name="joystickDevice" default="/dev/input/js0"/>

    <!-- TELEOPERATION -->
    <group if="$(arg enableJoystick)">
        <node respawn="false" pkg="joy" type="joy_node" name="joystick">
            <param name="dev" value="$(arg joystickDevice)"/>
            <param name="deadzone" value="0.05"/>
        </node>
        <node name="logitech_fx10_gs" pkg="cola2_control" type="logitech_fx10_to_teleoperation_node.py" respawn="true"  output="screen" />
        <rosparam command="load" file="$(find cola2_xiroi)/config/logitech_fx10_to_teleoperation.yaml"/>
    </group>
    <group unless="$(arg enableJoystick)">
        <node name="keyboard" pkg="cola2_control" type="keyboard" output="screen">
	        <remap from="/keyboard" to="/joy"/>
        </node>
        <node name="keyboard_to_teleoperation" pkg="cola2_control" type="keyboard_to_teleoperation_node.py" />
    </group>
</launch>
