<launch>

    <!--  ################# Input arguments  #################  -->
    <arg name="robot_name" default="$(arg robot_name)"/>
    <arg name="place" default="uib_outdoors.yaml"/>
    
        <!-- Load robot description -->
    <include file="$(find xiroi_description)/launch/xiroi_description.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>


    <!--  TODO: find a better way to load this parameter file-->
    <rosparam command="load" file="$(find cola2_xiroi)/config/check_sensors.yaml"/>

    <!--  ##############  COLA2_CORE_COMMON  ##############  -->
    <rosparam command="load" file="$(find cola2_xiroi)/config/places/$(arg place)"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/frames.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/pilot.yaml"/>
	<rosparam command="load" file="$(find cola2_xiroi)/config/captain.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/safety.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/teleoperation.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/robot_localization.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/sensor_aggregator.yaml"/>
    <rosparam command="load" ns="diagnostic_aggregator" file="$(find cola2_xiroi)/config/analyzers.yaml" />
    <rosparam command="load" file="$(find cola2_xiroi)/config/default_param_handler.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/controller.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/sim_config/vehicle_status_parser.yaml"/>
    


    <!--  ################# OTHER  #################  -->
    <!-- <rosparam command="load" file="$(find cola2_xiroi)/config/master_sync/sync_xiroi.yaml"/> -->
    <!-- <rosparam command="load" file="$(find cola2_xiroi)/config/master_sync/sync_all_topics.yaml"/> -->
    <rosparam command="load" file="$(find cola2_xiroi)/config/emlid_gps.yaml"/>
    <rosparam command="load" file="$(find cola2_xiroi)/config/razor.yaml"/>
    <!-- <rosparam command="load" file="$(find cola2_xiroi)/config/arduino.yaml"/> -->
    <rosparam command="load" file="$(find cola2_xiroi)/config/m4atx.yaml"/>

</launch>
