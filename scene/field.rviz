Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /tf1/Frames1
        - /navigator_odometry1
        - /Imu1
      Splitter Ratio: 0.691666663
    Tree Height: 587
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 127; 127; 127
      Enabled: true
      Line Style:
        Line Width: 0.0299999993
        Value: Lines
      Name: grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        world:
          Value: true
        world_ned:
          Value: true
        xiroi/base_link:
          Value: true
        xiroi/gps:
          Value: true
        xiroi/imu:
          Value: true
        xiroi/odom:
          Value: true
        xiroi/thruster_1:
          Value: true
        xiroi/thruster_2:
          Value: true
      Marker Scale: 1
      Name: tf
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        world:
          world_ned:
            xiroi/odom:
              xiroi/base_link:
                xiroi/gps:
                  {}
                xiroi/imu:
                  {}
                xiroi/thruster_1:
                  {}
                xiroi/thruster_2:
                  {}
      Update Interval: 0
      Value: true
    - Class: rviz/Axes
      Enabled: false
      Length: 1
      Name: world_origin
      Radius: 0.100000001
      Reference Frame: world_ned
      Value: false
    - Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: robot_axes
      Radius: 0.100000001
      Reference Frame: xiroi/base_link
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: robot_model
      Robot Description: xiroi/robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Angle Tolerance: 0.100000001
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.300000012
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: false
      Enabled: true
      Keep: 10000
      Name: navigator_odometry
      Position Tolerance: 0.100000001
      Shape:
        Alpha: 0.5
        Axes Length: 1
        Axes Radius: 0.100000001
        Color: 255; 25; 0
        Head Length: 0.100000001
        Head Radius: 0.0500000007
        Shaft Length: 0.800000012
        Shaft Radius: 0.0199999996
        Value: Arrow
      Topic: /xiroi/ekf_map/odometry
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /xiroi/navigator/markers/landmarks
      Name: navigator_landmarks
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Alpha: 0.5
      Buffer Length: 1
      Class: rviz/Range
      Color: 255; 255; 255
      Enabled: true
      Name: altitude
      Queue Size: 100
      Topic: /xiroi/navigator/altitude
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Head Diameter: 0.300000012
      Head Length: 0.200000003
      Length: 0.300000012
      Line Style: Lines
      Line Width: 0.0299999993
      Name: trajectory_path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.0299999993
      Shaft Diameter: 0.100000001
      Shaft Length: 0.100000001
      Topic: /xiroi/captain/trajectory_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/PointStamped
      Color: 204; 41; 204
      Enabled: true
      History Length: 1
      Name: pilot_goal
      Radius: 0.200000003
      Topic: /xiroi/pilot/goal
      Unreliable: false
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /xiroi/pilot/waypoint_marker
      Name: pilot_waypoint
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /xiroi/virtual_cage/markers/cage
      Name: virtual_cage
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Acceleration properties:
        Acc. vector alpha: 1
        Acc. vector color: 255; 0; 0
        Acc. vector scale: 1
        Derotate acceleration: true
        Enable acceleration: false
      Axes properties:
        Axes scale: 5
        Enable axes: true
      Box properties:
        Box alpha: 1
        Box color: 255; 0; 0
        Enable box: true
        x_scale: 1
        y_scale: 1
        z_scale: 1
      Class: rviz_imu_plugin/Imu
      Enabled: true
      Name: Imu
      Topic: /xiroi/sensors/imu_raw
      Unreliable: false
      Value: true
      fixed_frame_orientation: true
  Enabled: true
  Global Options:
    Background Color: 165; 165; 165
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
  Value: true
  Views:
    Current:
      Angle: -0.285000205
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.0599999987
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.00999999978
      Scale: 75.284523
      Target Frame: xiroi/base_link
      Value: TopDownOrtho (rviz)
      X: -0.597489953
      Y: -0.441188991
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1026
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1867
  X: 53
  Y: 24
