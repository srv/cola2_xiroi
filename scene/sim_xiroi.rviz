Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /tf1/Frames1
        - /robot_axes1
      Splitter Ratio: 0.609664977
    Tree Height: 587
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 127; 127; 127
      Enabled: true
      Line Style:
        Line Width: 0.0299999993
        Value: Lines
      Name: grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        gps:
          Value: true
        imu:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        world:
          Value: true
        world_ned:
          Value: true
        xiroi:
          Value: true
        xiroi/base_link:
          Value: true
        xiroi/dvl:
          Value: true
        xiroi/dvl_altitude:
          Value: true
        xiroi/dynamics:
          Value: true
        xiroi/echosounder11:
          Value: true
        xiroi/echosounder12:
          Value: true
        xiroi/echosounder13:
          Value: true
        xiroi/echosounder14:
          Value: true
        xiroi/echosounder15:
          Value: true
        xiroi/gps:
          Value: true
        xiroi/guppy:
          Value: true
        xiroi/imu:
          Value: true
        xiroi/imu_filter:
          Value: true
        xiroi/micron:
          Value: true
        xiroi/modem:
          Value: true
        xiroi/multibeam:
          Value: true
        xiroi/pressure:
          Value: true
        xiroi/profiler:
          Value: true
        xiroi/sidescan_port:
          Value: true
        xiroi/sidescan_starbord:
          Value: true
        xiroi/thruster_0:
          Value: true
        xiroi/thruster_1:
          Value: true
        xiroi/thruster_2:
          Value: true
      Marker Scale: 1
      Name: tf
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        world:
          map:
            odom:
              xiroi:
                gps:
                  {}
                imu:
                  {}
          world_ned:
            xiroi/dynamics:
              {}
      Update Interval: 0
      Value: true
    - Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: world_origin
      Radius: 0.100000001
      Reference Frame: world_ned
      Value: true
    - Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: robot_axes
      Radius: 0.100000001
      Reference Frame: xiroi
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: robot_model
      Robot Description: xiroi/robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Angle Tolerance: 0.100000001
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.300000012
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Enabled: false
      Keep: 100
      Name: navigator_odometry
      Position Tolerance: 0.100000001
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.100000001
        Color: 255; 25; 0
        Head Length: 0.300000012
        Head Radius: 0.100000001
        Shaft Length: 1
        Shaft Radius: 0.0500000007
        Value: Arrow
      Topic: /xiroi/ekf_map/odometry
      Unreliable: false
      Value: false
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /xiroi/navigator/markers/landmarks
      Name: navigator_landmarks
      Namespaces:
        {}
      Queue Size: 100
      Value: false
    - Angle Tolerance: 0.100000001
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.300000012
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Enabled: false
      Keep: 100
      Name: simulated_odometry
      Position Tolerance: 0.100000001
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.100000001
        Color: 255; 25; 0
        Head Length: 0.300000012
        Head Radius: 0.100000001
        Shaft Length: 1
        Shaft Radius: 0.0500000007
        Value: Arrow
      Topic: /xiroi/dynamics/odometry
      Unreliable: false
      Value: false
    - Alpha: 0.5
      Buffer Length: 1
      Class: rviz/Range
      Color: 255; 255; 255
      Enabled: false
      Name: altitude
      Queue Size: 100
      Topic: /xiroi/navigator/altitude
      Unreliable: false
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: false
      Head Diameter: 0.300000012
      Head Length: 0.200000003
      Length: 0.300000012
      Line Style: Lines
      Line Width: 0.0299999993
      Name: trajectory_path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.0299999993
      Shaft Diameter: 0.100000001
      Shaft Length: 0.100000001
      Topic: /xiroi/captain/trajectory_path
      Unreliable: false
      Value: false
    - Alpha: 1
      Class: rviz/PointStamped
      Color: 204; 41; 204
      Enabled: true
      History Length: 1
      Name: pilot_goal
      Radius: 0.200000003
      Topic: /xiroi/pilot/goal
      Unreliable: false
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /xiroi/pilot/waypoint_marker
      Name: pilot_waypoint
      Namespaces:
        /xiroi/pilot: true
      Queue Size: 100
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /xiroi/virtual_cage/markers/cage
      Name: virtual_cage
      Namespaces:
        virtual_cage: true
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 165; 165; 165
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8.36689568
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.0599999987
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 5.75895596
        Y: -11.7574263
        Z: -0.171386719
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.0500000007
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.00999999978
      Pitch: 0.574797273
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 5.47816992
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1026
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
