<launch>
	<!-- Params -->
	<arg name="rate"   	default= "1.0" />
	<arg name="init_time"  	default= "0" />

	<!-- Mission -->
	<arg name="path"   	 default= "/media/eric-uib/HardDisk/xiroi/bag/" />
	<arg name="mission"  default= "/2019_03_15_imu_razor_outdoors/antena" />
	<arg name="file0"    default= "/trip.bag" />


	<arg name="bags"   	default= "$(arg path)$(arg mission)$(arg file0)" />

	<!-- Topics -->
	<arg name="topics"   default="/xiroi/sensors/gps_raw
								  /xiroi/sensors/imu_cal_driver
								  /xiroi/sensors/imu_raw_driver
								  /xiroi/sensors/mag_cal_driver
								  /xiroi/sensors/mag_raw_driver 
								  " />

	<!-- Bagfile play -->
	<param name="use_sim_time" value="true"/>
	<node  name="rosbag" pkg="rosbag" type="play" args="--clock $(arg bags) -r $(arg rate) --start $(arg init_time) --topics $(arg topics)">
	</node>
</launch>
